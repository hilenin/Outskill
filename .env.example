# Copy to .env and fill in from Supabase Dashboard -> Settings -> API Keys
# The ANON key is safe for the front end (RLS protects data).
# NEVER put the service_role key here or anywhere in this project.
VITE_SUPABASE_URL=https://<your-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# n8n generation webhook (plan 05B) — production webhook URL of the generate-makeover workflow
VITE_N8N_WEBHOOK_URL=

# Shared API key the n8n webhook expects in the X-API-Key header (get it from the n8n team)
VITE_N8N_API_KEY=
